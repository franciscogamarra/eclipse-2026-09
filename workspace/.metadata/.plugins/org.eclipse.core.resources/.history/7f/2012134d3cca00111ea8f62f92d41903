	public static void main(String[] args) {
		
		JcClasse jc = JcClasse.build(st.class);
		
		Metodos metodos = ListMetodos.get(Css.class);
		metodos.removeIf(i -> i.isStatic());
		metodos.remove("kv$");
		
		metodos.each(i -> {
			
			JcMetodo m = jc.metodo(i.getName()).type(Css.class).static_().public_();
			
			if (i.getParameterCount() == 0) {
				m.return_("new Sto()." + i.getName() + "()");
			} else {
				m.param(i.getName(), i.getParametros().get(0).getType()).return_("new Sto()." + i.getName() + "("+i.getName()+")");				
			}
			
		});
		
		jc.addAnnotation(Support.class);
		
		jc.save();
		
	}

