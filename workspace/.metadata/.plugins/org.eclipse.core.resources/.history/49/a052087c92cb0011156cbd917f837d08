//@ImportCss("./LoginPage.scss")
public class LoginPage extends FC<LoginPage> {
	
	private StateBoolean loading = stateBoolean(false);
	private StateString cpf = stateString("");
	private StateString cpfInvalidMessage = stateString("");
	private StateString senha = stateString("");
	private StateString novaSenha = stateString("");
	private StateString novaSenhaConfirmacao = stateString("");
	private StateString email = stateString("");
	private StateString emailInvalidMessage = stateString("");
	private StateProp<LoginInput> model = state((LoginInput) ModelSupport.newModel("LoginInput"));
	private StateString etapa = stateString("login");
	private StateInt slide = stateInt(0);
	
	@Override
	protected ReactNode render() {
		
		useEffectUnmount(() -> {
			
			Campo campoCpf = model.get().campoCpf;
			Campo campoSenha = model.get().campoSenha;
			Campo campoNovaSenha = model.get().campoNovaSenha;
			Campo campoEmail = model.get().campoEmail;
			
			P0 observerCpf = campoCpf.value.observers.add(() ->
				cpf.set(campoCpf.value.getString())
			);
			
			P0 observerCpfInvalid = campoCpf.invalidMessage.observers.add(() -> {
				if (campoCpf.invalidMessage.isEmpty()) {
					cpfInvalidMessage.set("");
				} else {
					cpfInvalidMessage.set(campoCpf.valid.cause());
				}
			});
			
			P0 observerSenha = campoSenha.value.observers.add(() ->
				senha.set(campoSenha.value.getString())
			);
			
			P0 observerNovaSenha = campoNovaSenha.value.observers.add(() ->
				novaSenha.set(campoNovaSenha.value.getString())
			);
			
			P0 observerEmail = campoEmail.value.observers.add(() ->
				email.set(campoEmail.value.getString())
			);
			
			P0 observerEmailInvalid = campoEmail.invalidMessage.observers.add(() -> {
				if (campoEmail.invalidMessage.isEmpty()) {
					emailInvalidMessage.set("");
				} else {
					emailInvalidMessage.set(campoEmail.valid.cause());
				}
			});
			
			return () -> {
				campoCpf.value.observers.remove(observerCpf);
				campoCpf.invalidMessage.observers.remove(observerCpfInvalid);
				campoSenha.value.observers.remove(observerSenha);
				campoNovaSenha.value.observers.remove(observerNovaSenha);
				campoEmail.value.observers.remove(observerEmail);
				campoEmail.invalidMessage.observers.remove(observerEmailInvalid);
			};
			
		}, new Array<>(model));
		
		return (
			tag_main.r().className("page").ok(
				metadeEsquerda(),
				metadeDireita()
			)
		);
		
	}
	
	private void changeSlide() {
		Js.setTimeout(() -> {
			int x = slide.get() + 1;
			if (x > 1) {
				x = 0;
			}
			console.log(x);
			slide.set(x);
		}, 8000);
	}

	private ReactNode metadeEsquerdaMiolo() {

		changeSlide();
		
		return (
			div.r().style(Css.json().flexRow().width("2000px")).ok(
				div.r().style(Css.json().flexCol().width("1000px")).ok(
					span.r().className("eyebrow").ok(
						"RASTREAMENTO DE ATIVOS"
					),
					h1.r().ok(
						okString("Gestão conectada."),
						br_tag.r().ok(),
						span.r().className("accent").ok(
							"Decisões inteligentes."
						)
					),
					p.r().ok(
						"Acompanhe localização, uso e status de cada ativo em tempo real, com histórico completo e alertas automáticos em um único painel."
					)
				),
				div.r().style(Css.json().flexCol().width("1000px")).ok(
					span.r().className("eyebrow").ok(
						"CENTRAL DE GESTÃO"
					),
					h1.r().ok(
						okString("Sua operação conectada"),
						br_tag.r().ok(),
						span.r().className("accent").ok(
							"de ponta a ponta."
						)
					),
					p.r().ok(
						"Clientes, frota, equipamentos, eventos de inteligência artificial, atendimento, estoque e financeiro em um único ambiente."
					)
				)
			)
		);
		
	}
	
	private ReactNode metadeEsquerda() {
//        transform: `translateX(-${currentIndex * 100}%)`,
//        transition: isTransitioning ? 'transform 0.5s ease-in-out' : 'none',
//		<div className={"brand-copy"}>
		return (
			section.r().className("brand-panel").ok(
				Logo.r().ok(),
				div.r().className("brand-copy").style(Css.json().transition("transform 0.5s ease-in-out").transform("translateX(-"+(slide.get()*1000)+"px)")).ok(
					metadeEsquerdaMiolo()
				),
				routeArt()
			)
		);
	}
	
	private ReactNode metadeDireita() {
		return (
			section.r().className("login-panel").ok(
				div.r().className("login-card").ok(
					mioloDireita(),
					div.r().className("security-note").ok(
						Icone.r().name("shield-check").large().ok(),
						div.r().style(Css.json().display$flex().flexDirection$column().justifyContent$space__between().textAlign$center()).ok(
							span.r().ok("Sua conexão é protegida por criptografia."),
							span.r().ok("© 2026 Wisevia - v1.0.0")
						)
					)
				)
			)
		);
	}
	
	private ReactNode mioloDireita() {
		if (etapa.eq("login")) {
			return login();
		} else if (etapa.eq("trocar-senha")) {
			return trocarSenha();
		} else if (etapa.eq("esqueci-senha")) {
			return esqueciSenha();
		} else {
			return login();
		}
	}
	
	private ReactNode inputCpf() {
		return (
			Fragment.r().ok(
				div.r().className("label-row").ok(
					label.r().ok("CPF"),
					span.r().className("error").ok(cpfInvalidMessage.get())
				),
				div.r().className("input-wrap").ok(
					Icone.r().name("user").ok(),
					input.r()
						.type(InputTypeValues.text)
						.placeholder("Digite seu CPF")
						.autoComplete("username")
						.value(cpf.get())
						.onChange((ListenerEvent e) -> model.get().campoCpf.setValue(e.target.value))
					.ok()
				)
			)
		);
	}
	
	private ReactNode inputEmail() {
		return (
			Fragment.r().ok(
				div.r().className("label-row").ok(
					label.r().ok("E-mail"),
					span.r().className("error").ok(emailInvalidMessage.get())
				),
				div.r().className("input-wrap").ok(
					Icone.r().name("mail").ok(),
					input.r()
						.type(InputTypeValues.text)
						.placeholder("Digite seu E-mail")
						.autoComplete("email")
						.value(email.get())
						.onChange((ListenerEvent e) -> model.get().campoEmail.setValue(e.target.value))
					.ok()
				)
			)
		);
	}
	
	private ReactNode esqueciSenha() {
		return (
			Fragment.r().ok(
				div.r().className("card-heading").ok(
					span.r().className("section-tag").ok("ACESSO"),
					h2.r().ok("Esqueci minha senha"),
					p.r().ok("Enviaremos ao seu e-mail uma nova senha.")
				),
				inputCpf(),
				inputEmail(),
				buttons(
					Frag.r().ok(
						button.r().className("submit").type("button").disabled(loading.get()).onClick(() -> {
							etapa.set("login");
						}).ok(
							Icone.r().name("voltar").ok(),
							span.r().ok("Voltar")
						),
						button.r().className("submit").type("button").disabled(loading.get()).onClick(() -> {
							
							if (model.get().campoCpf.isEmpty()) {
								ShowMessage.error("CPF deve ser informado");
								return;
							}
							
							if (!model.get().campoCpf.valid.is()) {
								ShowMessage.error("Corrija o campo CPF");
								return;
							}
							
							if (model.get().campoEmail.isEmpty()) {
								ShowMessage.error("E-mail deve ser informado");
								return;
							}
							
							if (!model.get().campoEmail.valid.is()) {
								ShowMessage.error("Corrija o campo E-mail");
								return;
							}
							
							loading.set(true);
							Api.post("unauthenticated/login/recuperar-senha", model.get().montarJson(), String.class)
								.then(res -> {
									ShowMessage.success("Foi enviado um e-mail contendo a uma nova senha para o e-mail solicitado.");
									etapa.set("login");
									model.get().campoSenha.setValue("");
									return res;
								})
								.catch_(error -> {
									ShowMessage.error(error.getMessage());
								})
								.finally_(() -> loading.set(false));
							
						}).ok(
							span.r().ok(
								loading.get() ? "Enviando..." : "Enviar"
							),
							iif(!loading.get(), Icone.r().name("avancar").ok())
						)
					)
				)
			)
		);
	}
	
	private ReactNode login() {
		return (
			Fragment.r().ok(
				div.r().className("card-heading").ok(
					span.r().className("section-tag").ok("ACESSO"),
					h2.r().ok("Bem-vindo"),
					p.r().ok("Informe suas credenciais para continuar.")
				),
				inputCpf(),
				div.r().className("label-row").ok(
					label.r().ok("Senha"),
					a.r().onClick((MouseEvent e) -> {
						e.preventDefault();
						etapa.set("esqueci-senha");
					}).ok("Esqueceu sua senha?")
				),
				InputPass.r()
					.value(senha.get())
					.setValue((String value) -> model.get().campoSenha.setValue(value))
					.autoComplete("off")
				.ok(),
				buttons(
					button.r().className("submit").type("button").disabled(loading.get()).onClick(() -> {
						
						if (!model.get().campoCpf.valid.is()) {
							ShowMessage.error("Corrija o campo CPF");
							return;
						}
						
						if (!model.get().campoSenha.valid.is()) {
							ShowMessage.error("Corrija o campo senha");
							return;
						}
						
						loading.set(true);
						Api.post("unauthenticated/login", model.get().montarJson(), LoginOutput.class)
							.then(res -> {
								if (assumeNotNull(res).solicitarTrocaDeSenha) {
									etapa.set("trocar-senha");
								} else {
									sucessoLogin(res);
								}
								return res;
							})
							.catch_(error -> {
								ShowMessage.error(error.getMessage());
							})
							.finally_(() -> loading.set(false));
						
					}).ok(
						span.r().ok(
							loading.get() ? "Entrando..." : "Entrar"
						),
						iif(!loading.get(), Icone.r().name("avancar").ok())
					)
				)
			)
		);
	}
	
	private ReactNode trocarSenha() {
		return (
			Fragment.r().ok(
				div.r().className("card-heading").ok(
					span.r().className("section-tag").ok("ACESSO"),
					h2.r().ok("Troca de Senha"),
					p.r().ok("Informe sua nova senha para continuar.")
				),
				div.r().className("label-row").ok(
					label.r().ok("Nova Senha")
				),
				InputPass.r()
					.value(novaSenha.get())
					.setValue((String value) -> model.get().campoNovaSenha.setValue(value))
				.ok(),
				div.r().className("label-row").ok(
					label.r().ok("Repita a nova Senha")
				),
				InputPass.r()
					.value(novaSenhaConfirmacao.get())
					.setValue((String value) -> novaSenhaConfirmacao.set(value))
				.ok(),
				buttons(
					button.r().className("submit").type("button").disabled(loading.get()).onClick(() -> {
						
						if (novaSenha.isEmpty()) {
							ShowMessage.error("A nova senha deve ser informada");
							return;
						}
						
						if (novaSenhaConfirmacao.ne(novaSenha.get())) {
							ShowMessage.error("As senhas informadas não conferem");
							return;
						}
						
						loading.set(true);
						Api.post("unauthenticated/login/trocar-senha", model.get().montarJson(), LoginOutput.class)
							.then(res -> {
								sucessoLogin(res);
								return res;
							})
							.catch_(error -> {
								ShowMessage.error(error.getMessage());
							})
							.finally_(() -> loading.set(false));
						
					}).ok(
						span.r().ok(
							loading.get() ? "Confirmando..." : "Confirmar"
						),
						iif(!loading.get(), Icone.r().name("avancar").ok())
					)
				)
			)
		);
	}
	
	private void sucessoLogin(LoginOutput out) {
		if (!not(out)) {
			AuthController.set(LoginObj.json().cpf(assumeNotNull(cpf.get())).token(assumeNotNull(out.token)).nome(assumeNotNull(out.nome)));
		}
	}
	
