				.viewBox("0 0 560 220")
				.width("100%")
				.height("220")
				.preserveAspectRatio("xMidYMid meet")
				.aria_hidden("true")
			.ok(
				defs.r().ok(
					linearGradient.r().id("routeGradient").x1("0").y1("0").x2("1").y2("0").ok(
