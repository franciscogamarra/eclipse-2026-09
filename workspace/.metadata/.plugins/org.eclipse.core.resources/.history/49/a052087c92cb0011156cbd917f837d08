						stop.r().offset("18%").stopColor("#3fba83").stopOpacity(".55").ok(),
						stop.r().offset("100%").stopColor("#5ecf9a").stopOpacity(".55").ok()
					)
				),
				path.r()
					.className("route-path")
					.d("M40,168 C 100,120 130,160 190,132 S 300,72 340,96 S 430,150 500,60")
					.pathLength("900")
				.ok(),
				circle.r().className("route-node").cx("40").cy("168").r£("5").ok(),
				circle.r().className("route-node").cx("190").cy("132").r£("5").ok(),
				circle.r().className("route-node").cx("340").cy("96").r£("5").ok(),
				circle.r().className("route-ping").cx("500").cy("60").r£("7").ok(),
				circle.r().className("route-node is-live").cx("500").cy("60").r£("6").ok()
			)
		);
		
	}
	
	private ReactNode buttons(ReactNode body) {
		return (
			Fragment.r().ok(
				div.r().style(Css.json().marginTop("20px")).ok(),
				divider(),
				div.r().style(Css.json().flexRow()).ok(
					body
				),
				divider()
			)
		);
	}
	
	private ReactNode divider() {
		return div.r().className("divider").ok();
	}
	
	@IgnorarDaquiPraBaixo
	public static void main(String[] args) {
		WiseviaTranspilar.exec(LoginPage.class, false);
	}
	
	public static LoginPage r() {
		return new LoginPage();
	}
	
}
