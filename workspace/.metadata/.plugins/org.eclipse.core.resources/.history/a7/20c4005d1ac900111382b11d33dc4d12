package br.wisevia.src.logado;

import br.wisevia.WiseviaTranspilar;
import exec.ts.infra.FC;
import gm.utils.anotacoes.IgnorarDaquiPraBaixo;
import html.div;
import html.span;
import react.support.ReactNode;

public class LogadoPage extends FC<LogadoPage> {
	
	@Override
	protected ReactNode render() {
		return (
			div.r().ok(
				span.r().ok(okString("sucesso")),
				span.r().ok(okString("logout"))
			)
		);
	}
	
	@IgnorarDaquiPraBaixo
	public static void main(String[] args) {
		WiseviaTranspilar.exec(LogadoPage.class, false);
	}
	
	public static LogadoPage r() {
		return new LogadoPage();
	}
	
}
